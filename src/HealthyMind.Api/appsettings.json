{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "HealthyMind": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "HealthyMind",
    "Audience": "HealthyMind.Mobile",
    "SigningKey": "",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "RefreshTokenLifetimeDays": 60
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 10
  },
  "Groq": {
    "BaseUrl": "https://api.groq.com/openai/v1/",
    "ApiKey": "",
    "Model": "openai/gpt-oss-120b",
    "ReasoningEffort": "low",
    "Temperature": 0.4,
    "MaxCompletionTokens": 2000,
    "TimeoutSeconds": 30
  },
  "Recommendations": {
    "MinHoursBetween": 24,
    "LookbackDays": 30,
    "BatchSize": 25
  },
  "Firebase": {
    "CredentialsBase64": ""
  },
  "RecommendationJob": {
    "Enabled": true,
    "IntervalMinutes": 60,
    "InitialDelaySeconds": 30
  }
}
