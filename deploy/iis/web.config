<?xml version="1.0" encoding="utf-8"?>
<!--
  Proxy inverso IIS -> API HealthyMind en el servidor Linux (Podman).
  Sitio IIS: https://maui.appservices.com.ec  (el certificado HTTPS lo pone IIS).

  Requisitos en el IIS (una sola vez):
    1. Instalar "URL Rewrite" y "Application Request Routing (ARR)".
    2. IIS Manager -> nodo del servidor -> Application Request Routing Cache -> Server Proxy Settings:
       marcar "Enable proxy" y en "Preserve client IP in the following header" dejar X-Forwarded-For.
    3. IIS Manager -> sitio -> URL Rewrite -> View Server Variables -> Add: HTTP_X_FORWARDED_PROTO
       (sin esto IIS devuelve 500.50 al aplicar esta regla).

  Destino: servidor Linux 192.168.1.47, contenedor hm-api publicado en el puerto 5080.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Todo lo que llega por HTTP se manda a HTTPS (la app Android solo acepta HTTPS). -->
        <rule name="Forzar HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <rule name="Proxy a HealthyMind API" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <!-- La API usa este encabezado para saber que el cliente entró por HTTPS. -->
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://192.168.1.47:5080/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Que IIS no reemplace los errores JSON (ProblemDetails) de la API por sus páginas HTML. -->
    <httpErrors existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <!-- 10 MB: suficiente para el push de sincronización. -->
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
