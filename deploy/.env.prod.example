# Copiar en el servidor como /srv/healthymind/.env  (chmod 600). NUNCA subir el .env real al repositorio.
# Generar claves:  openssl rand -base64 48

POSTGRES_PASSWORD=
JWT_SIGNING_KEY=
GROQ_API_KEY=

# Versión de la imagen cargada con docker load
API_TAG=1.0

# Modo presentación (IA cada 3 min). Dejar en false salvo el día de la demostración.
ALLOW_ON_DEMAND=false

# Avisos push: JSON de la cuenta de servicio de Firebase en base64 (base64 -w0 archivo.json). Vacío = sin push.
FIREBASE_CREDENTIALS_B64=

# Correo saliente (códigos de verificación y de recuperación de contraseña). Vacío = el código solo queda en el log.
# Gmail: smtp.gmail.com, usuario = la cuenta, contraseña = "contraseña de aplicación" (requiere verificación en 2 pasos).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Solo para el PRIMER arranque (crea el administrador). Después vaciar ADMIN_PASSWORD y reiniciar.
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
