# Copiar en el servidor como /srv/healthymind/.env  (chmod 600). NUNCA subir el .env real al repositorio.
# Generar claves:  openssl rand -base64 48

POSTGRES_PASSWORD=
JWT_SIGNING_KEY=
GROQ_API_KEY=

# Versión de la imagen cargada con docker load
API_TAG=1.0

# Modo presentación (IA cada 3 min). Dejar en false salvo el día de la demostración.
ALLOW_ON_DEMAND=false

# Solo para el PRIMER arranque (crea el administrador). Después vaciar ADMIN_PASSWORD y reiniciar.
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
